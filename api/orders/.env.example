# Kirin Day API – Deployment Environment Variables
# Copy this file as .env and fill in the values below

# ── APP CONFIG ──────────────────────────────────────────────
# URL frontend kamu di Vercel (tanpa trailing slash)
# Digunakan untuk menghasilkan link di email yang dikirim ke pembeli
APP_URL=https://kirin-day.vercel.app

# ── SUPABASE CONFIG ──────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=payment-proofs

# ── EMAIL (BREVO API) ────────────────────────────────────────
BREVO_API_KEY=xkeysib-your_brevo_api_key
# Alamat email pengirim yang sudah terverifikasi di Brevo (Single Sender)
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com

# ── ADMIN CREDENTIALS ────────────────────────────────────────
ADMIN_PASSWORD=your_secure_admin_password
