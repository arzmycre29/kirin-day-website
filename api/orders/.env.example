# Kirin Day API – Deployment Environment Variables
# Copy this file as .env and fill in the values below

# ── APP CONFIG ──────────────────────────────────────────────
# URL frontend kamu di Vercel (tanpa trailing slash)
# Digunakan untuk menghasilkan link di email yang dikirim ke pembeli
APP_URL=https://kirin-day.vercel.app

# ── SUPABASE CONFIG ──────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=payment-proofs

# ── EMAIL (SMTP GMAIL) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Gmail App Password (bukan password biasa)
# Cara buat: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password

# ── ADMIN CREDENTIALS ────────────────────────────────────────
ADMIN_PASSWORD=your_secure_admin_password
